<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 以下是浅色默认值，只作设计时兜底；运行时由 ThemeHelper.ApplyTemplateResources
         按“深浅色 / 高对比度”整组覆盖到窗口级资源。模板内一律用 DynamicResource 引用。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SliderRestBrush" Color="#3D000000"/>
    <SolidColorBrush x:Key="ThumbRingBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThumbStrokeBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="CardBrush" Color="#A8FFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="SegHoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="HoverTextBrush" Color="#191919"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C7000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="SwitchBorderBrush" Color="#6E000000"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SwitchThumbOnBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchBorderHoverBrush" Color="#99000000"/>
    <SolidColorBrush x:Key="SwitchThumbHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#B0271A"/>
    <SolidColorBrush x:Key="CaptionCloseGlyphBrush" Color="#FFFFFF"/>

    <!-- Win11 风格开关 -->
    <Style x:Key="Win11Switch" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource SwitchBorderBrush}"/>
                        <Border x:Name="Thumb" Width="12" Height="12" CornerRadius="6"
                                Background="{DynamicResource SwitchThumbBrush}" HorizontalAlignment="Left"
                                Margin="4,0,0,0" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource SwitchThumbOnBrush}"/>
                            <Setter TargetName="Thumb" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="20"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SwitchBorderHoverBrush}"/>
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource SwitchThumbHoverBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win11 风格滑杆：细圆角轨道 + 强调色已填充段 + 圆形拇指 -->
    <Style x:Key="Win11Slider" TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource SliderRestBrush}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Focusable="False" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="Ring" Fill="{DynamicResource ThumbRingBrush}" Stroke="{DynamicResource ThumbStrokeBrush}" StrokeThickness="1"/>
                                                <Ellipse x:Name="Dot" Width="12" Height="12"
                                                         Fill="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Width" Value="14"/>
                                                    <Setter TargetName="Dot" Property="Height" Value="14"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Dot" Property="Width" Value="16"/>
                                                    <Setter TargetName="Dot" Property="Height" Value="16"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Win11 风格分段选择（RadioButton 组）：选中项为强调色胶囊，悬停微亮 -->
    <Style x:Key="SegRadio" TargetType="RadioButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent" BorderThickness="1"
                            BorderBrush="Transparent" Padding="12,5" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Body" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegHoverBrush}"/>
                            <Setter TargetName="Body" Property="TextElement.Foreground" Value="{DynamicResource HoverTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Body" Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win11 风格标准按钮：细描边浅底，悬停微亮 -->
    <Style x:Key="Win11Button" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegHoverBrush}"/>
                            <Setter TargetName="Bg" Property="TextElement.Foreground" Value="{DynamicResource HoverTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win11 风格强调色主按钮：强调色底 + 白字，悬停/按下整体微暗以示反馈 -->
    <Style x:Key="Win11AccentButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                            BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 自绘标题栏的关闭键（Win10 兜底用）：Win11 关闭键的红底悬停 -->
    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#xE8BB;" FontSize="10"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource CaptionCloseGlyphBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionClosePressedBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource CaptionCloseGlyphBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
