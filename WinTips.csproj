<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WinTips</RootNamespace>
    <AssemblyName>WinTips</AssemblyName>
    <!-- 版本号唯一真源：设置页底部与托盘悬停提示都读它（见 Core/AppInfo.cs）。
         发版只改这里，不要在各处硬编码。 -->
    <Version>0.31</Version>
    <Product>WinTips</Product>
    <Description>Win11 风格的键盘状态提示（大写/数字/滚动锁定与 Insert 键）</Description>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003：WinForms 分析器要求 DPI 走 Application.SetHighDpiMode，本项目是 WPF 主程序
         （只用 WinForms 的 NotifyIcon），DPI 只能由清单声明，故静音该提示 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- 单文件发布产物只要 WinTips.exe：不要 PDB（否则 publish 目录会多出 WinTips.pdb）。
       仅当 PublishSingleFile=true 时生效，Debug/普通构建仍生成符号可调试。 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- App.xaml 移入 App/ 子目录后需显式声明为应用定义 -->
  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
    <Page Remove="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
