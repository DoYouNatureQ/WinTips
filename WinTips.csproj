<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 必须带上 Windows SDK 版本：开机自启在 MSIX 下要走 WinRT 的 StartupTask
         （写 HKCU\...\Run 会被包虚拟化吞掉），该 API 来自 Windows SDK 投影。
         19041 是 startupTask 清单扩展要求的最低 TargetPlatformVersion；
         SupportedOSPlatformVersion 放宽到 1809，保证免安装版仍能跑在旧版 Win10 上。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 不再启用 WinForms：托盘图标已换成原生 Shell_NotifyIcon（见 UI/TrayService.cs）。
         关掉它可以把 System.Windows.Forms / Forms.Primitives / System.Drawing / GDI+
         共约 19.8MB 的程序集从常驻内存里整体移除。 -->
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WinTips</RootNamespace>
    <AssemblyName>WinTips</AssemblyName>
    <!-- 版本号唯一真源：设置页底部与托盘悬停提示都读它（见 Core/AppInfo.cs）。
         发版只改这里，不要在各处硬编码。 -->
    <Version>0.4</Version>
    <Product>WinTips</Product>
    <Description>Win11 风格的键盘状态提示（大写/数字/滚动锁定与 Insert 键）</Description>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 单文件发布产物只要 WinTips.exe：不要 PDB（否则 publish 目录会多出 WinTips.pdb）。
       仅当 PublishSingleFile=true 时生效，Debug/普通构建仍生成符号可调试。 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- App.xaml 移入 App/ 子目录后需显式声明为应用定义 -->
  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
    <Page Remove="App\App.xaml" />
  </ItemGroup>

  <!-- 显式关掉这两个命名空间的隐式 using：项目里已无 System.Drawing / WinForms 依赖 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
