<Window x:Class="WinTips.UI.PlacementPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义提示位置"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">
    <!-- 自定义位置模式：全屏半透明遮罩压暗桌面，浮窗与拖动提示浮于其上 -->
    <Grid x:Name="Root">
        <!-- 半透明背景：置于浮窗与拖动提示之下（最底层），形成摆放模式并挡住桌面点击 -->
        <Border x:Name="Scrim" Background="#40000000"/>

        <Canvas x:Name="DragLayer">
            <!-- 1:1 复刻真实提示卡片（正常尺寸、开启态外观），按住即可拖动 -->
            <Border x:Name="TipCard" CornerRadius="8" BorderThickness="1"
                    Cursor="SizeAll" Opacity="0" Height="50">
                <Grid Margin="16,4,12,8">
                    <Viewbox HorizontalAlignment="Left" Width="22" Height="22"
                             VerticalAlignment="Center" Margin="0,0,0,-2">
                        <Canvas Width="24" Height="24" ClipToBounds="False">
                            <Path Data="M7.25 7A3.25 3.25 0 0 0 4 10.25v7.5C4 19.55 5.46 21 7.25 21h9.5c1.8 0 3.25-1.46 3.25-3.25v-7.5C20 8.45 18.54 7 16.75 7H7.25Zm0 1.5h9.5c.97 0 1.75.78 1.75 1.75v7.5c0 .97-.78 1.75-1.75 1.75h-9.5c-.97 0-1.75-.78-1.75-1.75v-7.5c0-.97.78-1.75 1.75-1.75Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                            <Path Data="M12 15.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                            <Path Data="M8 7V5a4 4 0 0 1 8 0v2h-1.5V5a2.5 2.5 0 0 0-5 0v2H8Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="大写锁定 开启" FontSize="14" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0,0,2"/>
                    <Rectangle Height="3" Width="60" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" Margin="0,0,0,6"
                               Fill="{DynamicResource AccentBrush}"/>
                </Grid>
            </Border>

            <!-- 拖动提示 + 操作按钮：跟随浮窗（下方优先，贴底时翻到上方） -->
            <Border x:Name="HintBar" CornerRadius="8" BorderThickness="1" Padding="14,8" Opacity="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HintText" Text="按住浮窗拖到目标位置" FontSize="12.5"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource Win11Button}" Margin="16,0,0,0"/>
                    <Button x:Name="SaveBtn" Content="保存位置" Style="{StaticResource Win11AccentButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
