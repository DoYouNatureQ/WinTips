<Window x:Class="WinTips.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WinTips.Core"
        Title="WinTips OSD"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        Width="160" Height="50"
        FontFamily="{DynamicResource AppUiFont}"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Root">
        <Rectangle x:Name="GlassImage" RadiusX="8" RadiusY="8" Visibility="Collapsed"/>
        <Rectangle x:Name="GlassPlate" RadiusX="8" RadiusY="8" Margin="0.5"
                   StrokeThickness="1" Visibility="Collapsed"/>
        <Grid x:Name="ContentGrid" Margin="16,6,12,10">
            <Viewbox x:Name="LockSymbol" HorizontalAlignment="Left" Width="22" Height="22"
                     VerticalAlignment="Center" Margin="0,0,0,-2">
                <Canvas Width="24" Height="24" ClipToBounds="False">
                    <Path Data="M7.25 7A3.25 3.25 0 0 0 4 10.25v7.5C4 19.55 5.46 21 7.25 21h9.5c1.8 0 3.25-1.46 3.25-3.25v-7.5C20 8.45 18.54 7 16.75 7H7.25Zm0 1.5h9.5c.97 0 1.75.78 1.75 1.75v7.5c0 .97-.78 1.75-1.75 1.75h-9.5c-.97 0-1.75-.78-1.75-1.75v-7.5c0-.97.78-1.75 1.75-1.75Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                    <Path Data="M12 15.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                    <Path x:Name="LockShackle"
                          Data="M8 7V5a4 4 0 0 1 8 0v2h-1.5V5a2.5 2.5 0 0 0-5 0v2H8Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ShackleRotation" Angle="25" CenterX="16" CenterY="7"/>
                                <TranslateTransform x:Name="ShackleBounce" Y="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>
            <Viewbox x:Name="ClipSymbol" HorizontalAlignment="Left" Width="22" Height="22"
                     VerticalAlignment="Center" Visibility="Collapsed">
                <Canvas Width="24" Height="24" ClipToBounds="False">
                    <Path x:Name="CheckMark"
                          Data="M5,12.5 L10,17.5 L19,7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" StrokeDashArray="8.75 8.75" StrokeDashOffset="8.75"/>
                    <TextBlock x:Name="CutGlyph" Text="&#xE8C6;" Visibility="Collapsed"
                               FontFamily="{x:Static core:AppFont.Icon}"
                               FontSize="16" Width="24" Height="24" Padding="0,4,0,0"
                               TextAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                </Canvas>
            </Viewbox>
            <Viewbox x:Name="LangSymbol" HorizontalAlignment="Left" Width="22" Height="22"
                     VerticalAlignment="Center" Visibility="Collapsed">
                <Canvas Width="24" Height="24" ClipToBounds="False">
                    <Path Data="M3,11 A8,8 0 1 0 19,11 A8,8 0 1 0 3,11 M11,3 A4.5,8 0 0 0 11,19 A4.5,8 0 0 0 11,3 M3,11 H19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Fill="Transparent"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="LockTextBlock" FontSize="14" FontWeight="Medium"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0,0,2"/>
            <Viewbox x:Name="WelcomeSymbol" HorizontalAlignment="Left" Width="22" Height="22"
                     VerticalAlignment="Center" Visibility="Collapsed">
                <Canvas Width="24" Height="24" ClipToBounds="False">
                    <Ellipse x:Name="WelcomeBadge" Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"/>
                    <Path x:Name="WelcomeCheck" Data="M7.9,12.3 L10.7,15.1 L16.3,9.3"
                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel x:Name="WelcomeText" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="40,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="WelcomeTitle" FontSize="14" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="WelcomeSubtitle" FontSize="11.5" Margin="0,2,0,0" Opacity="0.7"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border x:Name="CountBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="9" Padding="7,2" Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BadgeScale"/>
                </Border.RenderTransform>
                <TextBlock x:Name="CountText" FontSize="12.5" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Rectangle x:Name="LockIndicator" Fill="#0067C0" Height="3" RadiusX="2" RadiusY="2"
                   Width="36" Opacity="0.2" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
    </Grid>
</Window>
