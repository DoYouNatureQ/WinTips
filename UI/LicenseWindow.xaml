<Window x:Class="WinTips.UI.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinTips.Core"
        Title="{loc:Tr LicenseTitle}" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource AppUiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="LegacyCaption" Grid.Row="0" Height="36" Visibility="Collapsed"
              MouseLeftButtonDown="LegacyCaption_MouseLeftButtonDown">
            <TextBlock Text="{loc:Tr LicenseTitle}" FontSize="12" Margin="16,0,56,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Style="{StaticResource CaptionCloseButton}" HorizontalAlignment="Right"
                    Click="Close_Click" AutomationProperties.Name="Close"/>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource Win11ScrollBar}"/>
            </ScrollViewer.Resources>

            <Grid x:Name="Panel" Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:Tr LicenseTitle}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Subtitle" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border x:Name="CreditCard" Grid.Row="1" Margin="0,16,0,0" CornerRadius="8" BorderThickness="1"
                        Padding="16,4,16,4"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                    <StackPanel>
                        <StackPanel Margin="0,10,0,10">
                            <TextBlock Text="HarmonyOS Sans SC" FontSize="14" FontWeight="Medium"/>
                            <TextBlock x:Name="FontDesc" Text="{loc:Tr LicenseFontDesc}" FontSize="11.5"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border x:Name="Sep1" Height="1" Margin="0,2" Opacity="0.5"/>
                        <TextBlock x:Name="Credit" Text="{loc:Tr LicenseCredit}" FontSize="11.5"
                                   Margin="0,10,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock FontSize="12.5" Margin="17,0,0,0">
                        <Hyperlink x:Name="AgreementToggle" Click="AgreementToggle_Click" TextDecorations="{x:Null}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" FontSize="12.5" Margin="0,0,17,0">
                        <Hyperlink x:Name="OfficialLink" TextDecorations="{x:Null}"
                                   ToolTip="https://gitcode.com/openharmony/global_system_resources/blob/master/LICENSE_Fonts"
                                   NavigateUri="https://gitcode.com/openharmony/global_system_resources/blob/master/LICENSE_Fonts"
                                   RequestNavigate="OfficialLink_RequestNavigate"><Run Text="{loc:Tr LicenseOfficialLink}"/></Hyperlink>
                    </TextBlock>
                </Grid>

                <Border x:Name="TextCard" Grid.Row="3" Margin="0,10,0,0" Height="300" Visibility="Collapsed"
                        CornerRadius="8" BorderThickness="1" Padding="8,6,4,6"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                    <TextBox x:Name="AgreementText" IsReadOnly="True" IsTabStop="False"
                             BorderThickness="0" Background="Transparent" Padding="4,2,10,2"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" FontSize="11.5">
                        <TextBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource Win11ScrollBar}"/>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <Button x:Name="CloseBtn" Grid.Row="4" Content="{loc:Tr LicenseClose}"
                        Style="{StaticResource Win11AccentButton}" IsDefault="True"
                        HorizontalAlignment="Right" Margin="0,14,0,0" MinWidth="88"
                        Click="Close_Click"/>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
