<Window x:Class="WinTips.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WinTips.Core"
        Title="WinTips Menu"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource AppUiFont}"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="MenuItemBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource HoverTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Win10 没有系统亚克力：抓一张背后桌面的模糊快照铺在卡片底下，蒙版和描边各一层。
             两张矩形都带 8px 圆角，配合分层窗口的透明四角，看起来就和 Win11 的亚克力菜单一样。 -->
        <Rectangle x:Name="GlassImage" RadiusX="8" RadiusY="8" Visibility="Collapsed"/>
        <Rectangle x:Name="GlassPlate" RadiusX="8" RadiusY="8" Margin="0.5"
                   StrokeThickness="1" Visibility="Collapsed"/>
        <Border x:Name="Root" CornerRadius="8" Padding="5" Background="Transparent">
            <ScrollViewer x:Name="Scroller" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource Win11ScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="ItemsHost" MinWidth="236"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
