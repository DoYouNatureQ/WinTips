<Window x:Class="WinTips.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTips 设置" Width="448" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" ShowInTaskbar="False">
    <!-- Win11 设置风格：Mica 底 + 圆角半透明卡片分组 -->
    <Grid x:Name="Panel" Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="键盘状态提示" FontSize="20" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock x:Name="SubText" Text="按下对应按键时，在任务栏上方显示系统风格提示"
                       FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="LblKeys" Text="提示键位" FontSize="13" Margin="1,0,0,7"/>
            <Border x:Name="Card1" CornerRadius="8" BorderThickness="1" Padding="16,6,16,6"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                <StackPanel>
                    <Grid Margin="0,8">
                        <ToggleButton x:Name="CapsToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                        <TextBlock Text="大写锁定（Caps Lock）" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="SepK1" Height="1" Margin="0,3" Opacity="0.5"/>
                    <Grid Margin="0,8">
                        <ToggleButton x:Name="NumToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                        <TextBlock Text="数字锁定（Num Lock）" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="SepK2" Height="1" Margin="0,3" Opacity="0.5"/>
                    <Grid Margin="0,8">
                        <ToggleButton x:Name="ScrollToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                        <TextBlock Text="滚动锁定（Scroll Lock）" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="SepK3" Height="1" Margin="0,3" Opacity="0.5"/>
                    <Grid Margin="0,8">
                        <ToggleButton x:Name="InsertToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Insert 键（事件提示，无开/关状态）" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="LblBehavior" Text="行为" FontSize="13" Margin="1,0,0,7"/>
            <Border x:Name="Card2" CornerRadius="8" BorderThickness="1" Padding="16,6,16,6"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                <StackPanel>
                    <StackPanel Margin="0,10">
                        <Grid>
                            <TextBlock Text="提示停留时长" FontSize="14"/>
                            <TextBlock x:Name="DurationText" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="DurationSlider" Style="{StaticResource Win11Slider}" Minimum="1" Maximum="5" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,12,0,4"/>
                    </StackPanel>
                    <Border x:Name="SepB1" Height="1" Margin="0,3" Opacity="0.5"/>
                    <StackPanel Margin="0,10">
                        <Grid>
                            <TextBlock Text="浮现动画速度" FontSize="14"/>
                            <TextBlock x:Name="AnimSpeedText" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="AnimSpeedSlider" Style="{StaticResource Win11Slider}" Minimum="0" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,12,0,4"/>
                    </StackPanel>
                    <Border x:Name="SepB2" Height="1" Margin="0,3" Opacity="0.5"/>
                    <Grid Margin="0,8">
                        <ToggleButton x:Name="StartupToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                        <TextBlock Text="开机自动运行" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock x:Name="FooterText" Grid.Row="4" FontSize="11.5" Margin="1,20,0,0"
                   TextWrapping="Wrap">
            <Hyperlink NavigateUri="https://natureq.top/" RequestNavigate="Hyperlink_RequestNavigate">By NatureQ</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
