<Window x:Class="WinTips.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinTips.Core"
        Title="{loc:Tr SettingsTitle}" Width="800" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" ShowInTaskbar="False"
        FontFamily="{DynamicResource AppUiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="LegacyCaption" Grid.Row="0" Height="36" Visibility="Collapsed"
              MouseLeftButtonDown="LegacyCaption_MouseLeftButtonDown">
            <TextBlock Text="{loc:Tr SettingsTitle}" FontSize="12" Margin="16,0,56,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Style="{StaticResource CaptionCloseButton}" HorizontalAlignment="Right"
                    Click="LegacyClose_Click" AutomationProperties.Name="Close"/>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource Win11ScrollBar}"/>
            </ScrollViewer.Resources>

            <Grid x:Name="Panel" Margin="26,20,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:Tr SettingsHeader}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubText" Text="{loc:Tr SettingsSubtitle}"
                               FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="348"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LblKeys" Grid.Row="0" Grid.Column="0" Text="{loc:Tr SectionKeys}" FontSize="13" Margin="1,0,0,7"/>
                    <TextBlock x:Name="LblBehavior" Grid.Row="0" Grid.Column="2" Text="{loc:Tr SectionGeneral}" FontSize="13" Margin="1,0,0,7"/>

                    <Border x:Name="Card1" Grid.Row="1" Grid.Column="0" CornerRadius="8" BorderThickness="1" Padding="16,6,16,6"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                        <StackPanel>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="CapsToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr KeyCapsLockLong}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK1" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="NumToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr KeyNumLockLong}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK2" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="ScrollToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr KeyScrollLockLong}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK3" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="InsertToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr RowInsert}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK4" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="CopyToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr RowCopy}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK5" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="PasteToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr RowPaste}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK6" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="CutToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Tr RowCut}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Border x:Name="SepK7" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="AnyCopyToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <StackPanel Margin="58,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr RowAnyCopy}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AnyCopyDesc" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:Tr RowAnyCopyDesc}"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="SepK8" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="LanguageToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <StackPanel Margin="58,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr RowLanguageTip}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LanguageDesc" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:Tr RowLanguageTipDesc}"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="SepK8c" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="LangWindowSwitchToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <StackPanel Margin="58,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr RowLanguageOnSwitch}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LangWindowSwitchDesc" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:Tr RowLanguageOnSwitchDesc}"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="SepK8b" Height="1" Margin="0,3" Opacity="0.5"/>
                            <Grid Margin="0,8">
                                <ToggleButton x:Name="FocusMonitorToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                <StackPanel Margin="58,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr RowFocusMonitor}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FocusMonitorDesc" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:Tr RowFocusMonitorDesc}"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="SepK9" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,8">
                                <Grid>
                                    <ToggleButton x:Name="GlassToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:Tr RowGlass}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock x:Name="GlassDesc" Text="{loc:Tr RowGlassDesc}" FontSize="11.5" Margin="58,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GlassOpacityLabel" Grid.Column="0" Text="{loc:Tr RowGlassOpacity}" FontSize="12.5"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="GlassOpacitySlider" Grid.Column="1" Style="{StaticResource Win11Slider}" Minimum="0.2" Maximum="0.9" TickFrequency="0.05"
                                        VerticalAlignment="Center" Margin="0,0,14,0"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        Thumb.DragStarted="GlassOpacitySlider_DragStarted" Thumb.DragCompleted="GlassOpacitySlider_DragCompleted"/>
                                <TextBlock x:Name="GlassOpacityText" Grid.Column="2" FontSize="12.5" VerticalAlignment="Center"
                                           TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Card2" Grid.Row="1" Grid.Column="2" CornerRadius="8" BorderThickness="1" Padding="16,6,16,6"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                        <StackPanel>
                            <StackPanel Margin="0,6">
                                <Grid>
                                    <TextBlock Text="{loc:Tr RowDuration}" FontSize="14"/>
                                    <TextBlock x:Name="DurationText" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="DurationSlider" Style="{StaticResource Win11Slider}" Minimum="0.5" Maximum="5" TickFrequency="0.5"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border x:Name="SepB1" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,6">
                                <Grid>
                                    <TextBlock Text="{loc:Tr RowAnimSpeed}" FontSize="14"/>
                                    <TextBlock x:Name="AnimSpeedText" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="AnimSpeedSlider" Style="{StaticResource Win11Slider}" Minimum="0" Maximum="3" TickFrequency="0.1"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border x:Name="SepB2" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,6">
                                <Grid>
                                    <TextBlock Text="{loc:Tr RowTipScale}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TipScaleText" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="ResetScaleBtn" Content="{loc:Tr BtnResetSize}" Style="{StaticResource Win11Button}"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="TipScaleSlider" Style="{StaticResource Win11Slider}" Minimum="0.6" Maximum="2" TickFrequency="0.1"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,5,0,3"
                                        Thumb.DragStarted="TipScaleSlider_DragStarted" Thumb.DragCompleted="TipScaleSlider_DragCompleted"/>
                                <TextBlock x:Name="TipScaleDesc" Text="{loc:Tr RowTipScaleDesc}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border x:Name="SepB2b" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,10">
                                <TextBlock Text="{loc:Tr RowPosition}" FontSize="14"/>
                                <WrapPanel Margin="0,10,0,2" Orientation="Horizontal">
                                    <RadioButton x:Name="PosTop" Content="{loc:Tr PositionTop}" GroupName="TipVertical" Style="{StaticResource SegRadio}"/>
                                    <RadioButton x:Name="PosBottom" Content="{loc:Tr PositionBottom}" GroupName="TipVertical" Style="{StaticResource SegRadio}" Margin="6,0,0,0"/>
                                    <RadioButton x:Name="PosLeft" Content="{loc:Tr PositionLeft}" GroupName="TipHorizontal" Style="{StaticResource SegRadio}" Margin="12,0,0,0"/>
                                    <RadioButton x:Name="PosCenter" Content="{loc:Tr PositionCenter}" GroupName="TipHorizontal" Style="{StaticResource SegRadio}" Margin="6,0"/>
                                    <RadioButton x:Name="PosRight" Content="{loc:Tr PositionRight}" GroupName="TipHorizontal" Style="{StaticResource SegRadio}"/>
                                </WrapPanel>
                            </StackPanel>
                            <Border x:Name="SepB3" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,10">
                                <Grid>
                                    <TextBlock Text="{loc:Tr RowCustomPos}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="CustomPosBtn" Content="{loc:Tr BtnAdjustPos}" Style="{StaticResource Win11Button}"/>
                                        <Button x:Name="ResetPosBtn" Content="{loc:Tr BtnResetPos}" Style="{StaticResource Win11Button}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CustomPosDesc" Text="{loc:Tr RowCustomPosDesc}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border x:Name="SepB4" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,8">
                                <Grid>
                                    <ToggleButton x:Name="StartupToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:Tr RowStartup}" FontSize="14" Margin="58,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock x:Name="StartupHint" FontSize="11.5" Margin="58,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <Border x:Name="SepB5" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,8">
                                <Grid>
                                    <TextBlock Text="{loc:Tr RowLanguage}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr LangSystem}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="LangSystemToggle" Style="{StaticResource Win11Switch}"/>
                                    </StackPanel>
                                </Grid>
                                <ComboBox x:Name="LangCombo" Style="{StaticResource Win11ComboBox}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border x:Name="SepB6" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,10">
                                <TextBlock Text="{loc:Tr RowUiFont}" FontSize="14"/>
                                <ComboBox x:Name="FontCombo" Style="{StaticResource Win11ComboBox}" Margin="0,8,0,0"
                                          MaxDropDownHeight="320"/>
                                <TextBlock x:Name="FontDesc" Text="{loc:Tr RowUiFontDesc}" FontSize="11.5"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border x:Name="SepB7" Height="1" Margin="0,3" Opacity="0.5"/>
                            <StackPanel Margin="0,8">
                                <Grid>
                                    <TextBlock Text="{loc:Tr RowCheckUpdates}" FontSize="14" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="UpdateToggle" Style="{StaticResource Win11Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="UpdateDesc" Text="{loc:Tr RowCheckUpdatesDesc}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="FooterText" Grid.Row="2" FontSize="11.5" Margin="1,20,0,0"
                           TextWrapping="Wrap" TextAlignment="Center">
                    <Hyperlink x:Name="VersionLink" Click="VersionLink_Click" TextDecorations="{x:Null}">
                        <Hyperlink.ToolTip>
                            <ToolTip Style="{StaticResource Win11ToolTip}">
                                <StackPanel MaxWidth="300">
                                    <TextBlock Text="WinTips © 2026 NatureQ" FontWeight="Medium"/>
                                    <TextBlock Text="GPL-3.0 · github.com/DoYouNatureQ/WinTips" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="HarmonyOS Sans SC" FontWeight="Medium" Margin="0,6,0,0"/>
                                    <TextBlock Text="© Huawei Device Co., Ltd." FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{loc:Tr LicenseTip}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ToolTip>
                        </Hyperlink.ToolTip>
                        <Run x:Name="VersionRun" Text="V0.0"/>
                    </Hyperlink><Run Text="&#160;·&#160;"/><Hyperlink NavigateUri="https://github.com/DoYouNatureQ/WinTips/releases" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}"><Run Text="{loc:Tr GetLatestVersion}"/><InlineUIContainer BaselineAlignment="Top"><Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="#E5484D" Margin="4,1,0,0" Visibility="Collapsed"/></InlineUIContainer></Hyperlink>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
